	(gr_text "You now measure shunt + pour + solder joints. ~0.1 mOhm of stray copper = 6 mV at 60 A"
		(at 25 147 0)
		(layer "Dwgs.User")
		(uuid "c0e89bd0-4c25-413d-a2d9-93caa701ef3d")
		(effects
			(font (size 1.5 1.5) (thickness 0.25))
			(justify left)
		)
	)
	(gr_text "= 20% error on a 30 mV signal. It scales with current, so calibration cannot remove it."
		(at 25 151 0)
		(layer "Dwgs.User")
		(uuid "9f2ad6a7-1702-441f-a84b-d6671adc2c0f")
		(effects
			(font (size 1.5 1.5) (thickness 0.25))
			(justify left)
		)
	)
	(gr_text "NOTES"
		(at 25 162 0)
		(layer "Dwgs.User")
		(uuid "ed67c5f6-e2d8-472d-9ac9-0619674cb723")
		(effects
			(font (size 1.9 1.9) (thickness 0.35))
			(justify left)
		)
	)
	(gr_text "1.  R1 = CSS2H-2512R-L500F, 0.5 mOhm.  Real body is 6.35 x 3.2 mm - drawn oversized here for clarity."
		(at 25 166.6 0)
		(layer "Dwgs.User")
		(uuid "02ea9160-d57a-42d7-a91e-47f0c92a5630")
		(effects
			(font (size 1.5 1.5) (thickness 0.25))
			(justify left)
		)
	)
	(gr_text "2.  At 60 A the shunt develops 30 mV.  A 1 mm x 10 mm trace in 1 oz copper is ~5 mOhm - ten times the shunt itself."
		(at 25 171.2 0)
		(layer "Dwgs.User")
		(uuid "eaccd070-41bc-41e9-a5a7-fb3372c4744c")
		(effects
			(font (size 1.5 1.5) (thickness 0.25))
			(justify left)
		)
	)
	(gr_text "     That is why the tap POINT, not the trace width, decides your accuracy."
		(at 25 175.8 0)
		(layer "Dwgs.User")
		(uuid "2834b4bc-ee17-4e0c-9378-7fdfe14b2b3f")
		(effects
			(font (size 1.5 1.5) (thickness 0.25))
			(justify left)
		)
	)
	(gr_text "3.  Power path: 2 oz copper, pour on both layers, stitched with via arrays."
		(at 25 180.4 0)
		(layer "Dwgs.User")
		(uuid "b9a71010-554f-4d0b-b672-d680294c0ee4")
		(effects
			(font (size 1.5 1.5) (thickness 0.25))
			(justify left)
		)
	)
	(gr_text "     Open the soldermask over the pour and flood it with solder at assembly."
		(at 25 185 0)
		(layer "Dwgs.User")
		(uuid "727f4815-c4d8-4766-b46a-644fd7df3086")
		(effects
			(font (size 1.5 1.5) (thickness 0.25))
			(justify left)
		)
	)
	(gr_text "4.  Route IN+ / IN- as a tight, equal-length pair, away from the power pour.  Keep U3 close to R1."
		(at 25 189.6 0)
		(layer "Dwgs.User")
		(uuid "70235f25-9947-4fdc-8471-75a0a622b01d")
		(effects
			(font (size 1.5 1.5) (thickness 0.25))
			(justify left)
		)
	)
	(gr_text "5.  Battery pads, R1 and output pads in a straight line at one board edge. Every extra mm is resistance and heat."
		(at 25 194.2 0)
		(layer "Dwgs.User")
		(uuid "29d64d10-0d40-4e2c-922c-e48911af4c45")
		(effects
			(font (size 1.5 1.5) (thickness 0.25))
			(justify left)
		)
	)
	(gr_text "6.  INA180A2 common-mode limit is 26 V.  6S off the charger is 25.2-25.5 V.  Tight - consider INA226/INA186 for 6S."
		(at 25 198.8 0)
		(layer "Dwgs.User")
		(uuid "49b3d1af-0869-415d-88c4-780b56d9a96a")
		(effects
			(font (size 1.5 1.5) (thickness 0.25))
			(justify left)
		)
	)
)
